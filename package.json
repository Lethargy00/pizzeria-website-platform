{
  "name": "pwp-root",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0 <27",
    "pnpm": "10.28.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "tenant-guard": "node scripts/tenant-guard.mjs",
    "check-boundaries": "node scripts/check-boundaries.mjs",
    "check-licenses": "node scripts/check-licenses.mjs",
    "review-gate": "node scripts/review-gate.mjs",
    "touches-guard": "node scripts/touches-guard.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts && pnpm tenant-guard && pnpm check-boundaries"
  },
  "devDependencies": {
    "@eslint/js": "9.30.0",
    "@playwright/test": "1.55.1",
    "@types/node": "24.0.10",
    "eslint": "9.30.0",
    "prettier": "3.10.1",
    "turbo": "2.5.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "vitest": "4.1.7"
  }
}
